# Veyra Prime — environment template.
#
# COMMITTED. Contains no real values, ever.
# The real .env lives ONLY at $MW_BUILD/mw/.env and is never synced to the Drive.
#
# RULE: anything prefixed VITE_ is PUBLIC — Vite inlines it into the client bundle at
# build time. If a secret is ever given a VITE_ prefix, treat it as leaked and rotate it.
# See docs/PLATFORM_STANDARD.md §4.1.

# ── paths ─────────────────────────────────────────────────────────────────────
# Quote both. MW_ROOT contains spaces AND an '@'. An unquoted expansion in a shell
# script splits the path and deletes something you liked. CI greps for $MW_ROOT[^"].
MW_ROOT="/Users/angseesiang/Library/CloudStorage/GoogleDrive-ang.see.siang@gmail.com/My Drive/macbook/MechWarrior"
MW_BUILD="$HOME/mw-build"

# ── generators — SERVER-SIDE ONLY ─────────────────────────────────────────────
# Never bundled. Never VITE_-prefixed. Read only by scripts/ and ops/ tooling.

# Tripo3D. Free-tier output is NOT licensed for commercial use — the paid plan must
# cover every already-generated model retroactively (CONVERGENCE_PLAN.md §9.1).
TRIPO_API_KEY=
TRIPO_API_BASE="https://api.tripo3d.ai/v2/openapi"
TRIPO_PLAN=
TRIPO_MODEL_TOPOLOGY=          # current P1-class version string — verify before every batch
TRIPO_MODEL_HERO=              # current H3.1-class version string
TRIPO_CREDIT_BUDGET_MILESTONE= # tools-tripo refuses batches above this without --override

# ElevenLabs. Plan gates the output format (PIPELINE_STANDARD.md §7.1):
#   pcm_44100 / wav_44100  → Pro tier or above
#   mp3_44100_192          → Creator tier or above
# Below Creator the pipeline refuses to run. That is intentional.
ELEVENLABS_API_KEY=
ELEVEN_PLAN=                             # "Creator" | "Pro" | …
ELEVEN_TTS_MODEL="eleven_multilingual_v2"
ELEVEN_MASTER_FORMAT="pcm_44100"         # 44.1 kHz PCM master, archived to assets-source/audio-master
ELEVEN_DELIVERY_BITRATE="192k"           # encoded LOCALLY from that master
ELEVEN_DELIVERY_FALLBACK_FORMAT="mp3_44100_192"   # if plan < Pro: request 192 kbps directly
ELEVEN_CREDIT_BUDGET_MILESTONE=

# ── runtime (PUBLIC — inlined into the client bundle) ─────────────────────────
# Leave both unset to fall back to same-origin (/ws, /api), which is correct if the
# game is ever served from the Worker itself again. See .env.production.
VITE_MP_URL=
VITE_API_URL=

# ── service ───────────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
