{
  "name": "veyra-prime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Veyra Prime (working title 'MechWarrior') \u2014 browser-based giant-robot combat simulator. M0 vertical slice.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "audio": "node scripts/gen_audio.mjs",
    "smoke": "node scripts/screenshot.mjs",
    "mp": "node server/mp-server.mjs",
    "mpaudio": "node scripts/gen_mp_audio.mjs",
    "btlint": "node scripts/lint_bt.mjs",
    "bttest": "node scripts/test_bt.mjs",
    "btaudio": "node scripts/gen_bt_audio.mjs",
    "btsfx": "node scripts/gen_bt_sfx.mjs",
    "campaudio": "node scripts/gen_campaign_audio.mjs",
    "music": "node scripts/gen_music.mjs",
    "musicmaster": "node scripts/master_music.mjs",
    "campcheck": "node scripts/validate_campaign.mjs",
    "camptest": "node scripts/test_campaign.mjs",
    "lightprobe": "node scripts/lightprobe.mjs",
    "navcheck": "node scripts/validate_nav.mjs",
    "navunit": "node scripts/test_nav_unit.mjs",
    "navtest": "node scripts/test_nav.mjs",
    "navaudio": "node scripts/gen_nav_audio.mjs",
    "tripomechs": "python3 scripts/gen_tripo_appearance.py",
    "tripocheck": "python3 scripts/check_tripo_quality.py",
    "lods": "node scripts/build_lods.mjs",
    "assetaudit": "node scripts/audit_assets.mjs",
    "assetverify": "node scripts/verify_assets.mjs",
    "hangarshot": "node scripts/shot_hangar.mjs",
    "hangartest": "node scripts/test_hangar.mjs",
    "hangarcheck": "node scripts/validate_hangar.mjs",
    "hangarui": "node scripts/test_hangar_ui.mjs",
    "sitefonts": "python3 scripts/build_site_fonts.py",
    "siteart": "python3 scripts/gen_site_art.py",
    "siteaudio": "node scripts/gen_site_audio.mjs",
    "siteimg": "python3 scripts/site_derivatives.py",
    "siteshots": "node scripts/site_shots_4k.mjs",
    "plinthshot": "node scripts/shot_plinth.mjs",
    "sitecheck": "node scripts/shot_site.mjs",
    "accounts:test": "node scripts/test_accounts.mjs",
    "savetest": "node scripts/verify_save.mjs",
    "accounts:probe": "node scripts/probe_accounts.mjs",
    "db:migrate": "wrangler d1 migrations apply veyra-accounts --local",
    "db:migrate:remote": "wrangler d1 migrations apply veyra-accounts --remote",
    "mpprobe": "node scripts/probe_mp.mjs",
    "steerprobe": "node scripts/probe_steer.mjs",
    "mporigin": "node scripts/probe_mp_origin.mjs",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name robot-mech --branch main --commit-dirty=true",
    "deploy:worker": "npm run build && wrangler deploy",
    "sync:test": "node scripts/test_sync.mjs",
    "schema": "node scripts/content_schema.mjs",
    "schema:types": "node scripts/content_schema.mjs --types"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "three": "^0.180.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "@types/three": "^0.180.0",
    "playwright-core": "^1.49.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
